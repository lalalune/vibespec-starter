{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDirs": [".", ".vibe/declarations"]
  },
  "include": ["src", "test", "gen/*.ts", "gen/*.vibe"],
  "vibe": { "sidecarDir": ".vibe/declarations" }
}
