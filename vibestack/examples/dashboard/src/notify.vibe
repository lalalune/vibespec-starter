// spec/tracker.md, "One pass of the notifier sends everything that is due and records that it was sent"
// The shell around `notify`: one chat message per person. It touches the outside world, so test/notify.test.vibe
// tests it; no proof. Duplicates are already ruled out by "Nothing is sent twice".
import type { Note } from "../gen/tracker.effect.vibe"

export interface Message { to: string; handle: string; text: string }

function line(n: Note): string {
  return match (n.kind) {
    when "Update": `✎ #${n.task} changed`;
    when "Soon": `⏳ #${n.task} due day ${n.version}`;
    when "Today": `⚠ #${n.task} due today`;
  }
}

/** One message per person with a chat handle, in the order people first appear. */
export function messages(notes: Note[], handles: Record<string, string>): Message[] {
  const byPerson = new Map<string, string[]>()
  for (const n of notes) if (handles[n.to]) byPerson.set(n.to, [...(byPerson.get(n.to) ?? []), line(n)])
  return [...byPerson].map(([to, lines]) => ({ to, handle: handles[to]!, text: lines.join("\n") }))
}

/** The chat app did not take a message. */
export error Undelivered { handle: string; cause: unknown }

/** The chat app, as far as the shell needs it; test/notify.test.vibe provides one that records. */
export service Chat {
  post(handle: string, text: string): void!Undelivered
}

/** Sends one pass's notes, one message after another; returns how many messages went out. */
export effect function send(notes: Note[], handles: Record<string, string>): number!Undelivered!Chat {
  const chat = try Chat
  const out = messages(notes, handles)
  for (const m of out) try chat.post(m.handle, m.text)
  return out.length
}
