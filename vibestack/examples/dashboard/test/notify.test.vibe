import { assert, it } from "@effect/vitest"
import { TestClock } from "effect/testing"
import { type Note, Machine, debounce, machine } from "../gen/tracker.effect.vibe"
import { Chat, Undelivered, messages, pass } from "../src/notify.vibe"

const handles = { ana: "@ana", ben: "@ben", cal: "@cal" }

// spec/tracker.md, "Story: Be told what changed and what is due"
it.effect("Be told what changed and what is due", () => effect {
  const posted: [string, string][] = []
  const attempts: Record<string, number> = {}
  const chat = {
    effect post(handle: string, text: string) {
      attempts[handle] = (attempts[handle] ?? 0) + 1
      if (handle === "@cal" || attempts[handle]! < 3) throw new Undelivered({ handle, cause: "busy" })
      posted.push([handle, text])
    },
  }
  provide machine(), Chat = chat {
    const tracker = try Machine
    try tracker.send({ type: "create", actor: "ben" })
    try tracker.send({ type: "handAddOwner", id: 1, name: "ana" })
    try tracker.send({ type: "handAddOwner", id: 1, name: "cal" })
    const typed = try tracker.send({ type: "handAddOwner", id: 1, name: "ana" })
    try Effect.try(() => assert.deepStrictEqual(typed.state.tasks[0]!.owners, ["ana", "cal", "ana"]))
    for (let i = 0; i < debounce; i++) try tracker.send({ type: "tick" })

    const first = fork pass(handles)
    try TestClock.adjust("999 millis")
    try Effect.try(() => assert.deepStrictEqual(attempts, { "@ana": 1 }))
    try TestClock.adjust("1 millis")
    try Effect.try(() => assert.deepStrictEqual(attempts, { "@ana": 2 }))
    try TestClock.adjust("1 minute")
    const undelivered = try join first
    // spec/tracker.md, "Nothing is sent twice"; spec/tracker.md, "A pass sends exactly the notes it records"
    try Effect.try(() => assert.deepStrictEqual(posted, [["@ana", "✎ #1 changed"]]))
    try Effect.try(() => assert.deepStrictEqual(attempts, { "@ana": 3, "@cal": 3 }))
    try Effect.try(() => assert.deepStrictEqual(undelivered, [{ to: "cal", handle: "@cal", text: "✎ #1 changed" }]))

    try tracker.send({ type: "tick" })
    const second = fork pass(handles)
    try TestClock.adjust("1 minute")
    const none = try join second
    // spec/tracker.md, "A pass sends exactly the notes it records"
    try Effect.try(() => assert.deepStrictEqual(none, []))
    try Effect.try(() => assert.deepStrictEqual(posted, [["@ana", "✎ #1 changed"]]))
  }
})

// spec/tracker.md, "One pass of the notifier sends everything that is due and records that it was sent"
it.effect("one message per person with a chat handle", () => effect {
  const notes: Note[] = [
    { kind: "Update", task: 1, to: "ana", version: 0, at: 3, by: "ben" },
    { kind: "Soon", task: 2, to: "ben", version: 4, at: 3, by: "" },
    { kind: "Today", task: 2, to: "ana", version: 1, at: 3, by: "" },
    { kind: "Update", task: 1, to: "ama", version: 0, at: 3, by: "ben" },
    { kind: "Update", task: 1, to: "toString", version: 0, at: 3, by: "ben" },
  ]
  try Effect.try(() => assert.deepStrictEqual(messages(notes, handles), [
    { to: "ana", handle: "@ana", text: "✎ #1 changed\n⚠ #2 due today" },
    { to: "ben", handle: "@ben", text: "⏳ #2 due day 4" },
  ]))
})
