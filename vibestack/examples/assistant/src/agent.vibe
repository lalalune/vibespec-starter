// The program around spec/assistant.md: it knows who sent each event from the service the event came
// through, never from what was said (spec/assistant.md, "Who sends an event").
import { Machine, type NotAnEvent, type Rejected } from "../gen/assistant.effect.vibe"
import type * as T from "../gen/assistant.effect.vibe"

export error NoAnswer { from: T.Actor }

/** The model that chooses the agent's actions. What it returns is untrusted. */
export service Model {
  choose(seen: T.Assistant): unknown!NoAnswer
}

/** Websites and devices: the biller's answer to a request, the page the browser shows, and what the program does to them. */
export service World {
  bill(request: number): number!NoAnswer
  page(): T.Page!!
  perform(carried: T.Effect): void!!
}

export type Said = "begin" | "confirm" | "decline"
export type Refusal = Rejected | NotAnEvent | NoAnswer

/** Where a turn stopped, and each answer of the model that ended it instead of becoming a choice. */
export interface Turn {
  readonly state: T.Assistant
  readonly refused: ReadonlyArray<Refusal>
}

/** Offers the rules the page showing now and, for a request still waiting, the biller's answer. */
effect function observe() {
  const machine = try Machine
  const world = try World
  const seen = try machine.send({ type: "load", page: try world.page() }, "World")
  if (!seen.waiting) return seen
  // spec/assistant.md, "A reply counts only for the request still waiting": no answer, or one refused, changes nothing.
  return effect {
    return try machine.receive({ type: "reply", request: seen.request, amount: try world.bill(seen.request) }, "World")
  } catch () => seen
}

// spec/assistant.md, "The program carries out the outbox, then empties it"
effect function carryOut(outbox: ReadonlyArray<T.Effect>) {
  const world = try World
  for (const carried of outbox) try world.perform(carried)
  // `drain` names no sender in the spec, so the one passed is not looked at.
  try (try Machine).send({ type: "drain" }, "Agent")
}

/**
 * What the person said, then the agent's actions until the turn ends or asks the person. It fails with `Rejected`
 * when the rules refuse what the person said.
 */
export effect function hear(said: Said): Turn!Rejected!(Machine | Model | World) {
  const machine = try Machine
  const model = try Model
  const refused: Refusal[] = []
  try observe()
  let state = try machine.send({ type: said }, "Person")
  // spec/assistant.md, "Every choice spends the budget": each pass makes one choice, so there are at most `maxActions`.
  while (state.phase === "Planning") {
    // The model's answer can only become the Agent's choice. Any other answer finishes the turn, which
    // spec/assistant.md, "A turn's budget stays within bounds, and a turn being planned has some left" allows.
    const chosen = effect {
      return try machine.receive({ type: "choose", choice: try model.choose(state) }, "Agent")
    } catch effect (error) => {
      refused.push(error)
      return try machine.send({ type: "choose", choice: "Finish" }, "Agent")
    }
    // The outbox as this choice left it, so `drain` empties nothing that no pass was given to carry out.
    try carryOut(chosen.outbox)
    state = try observe()
  }
  return { state, refused }
}
