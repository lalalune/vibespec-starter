// The assistant's state kept in one JSON file, so that a crash loses only what spec/assistant.md keeps in memory
// (spec/assistant.md, "Story: Survive a restart").
import { apply, decodeEvent, decodeState, initial, Machine, NotAState, type Rejected } from "../gen/assistant.effect.vibe"
import type * as T from "../gen/assistant.effect.vibe"

/**
 * A Machine kept in `file`: a missing file starts from `initial`, one that holds no state fails with `NotAState`.
 * Opening it is a restart, which comes from the world (spec/assistant.md, "A restart loses what was in memory and keeps
 * what was saved"). Each accepted event is in the file, written to a temporary file, synced to the disk and renamed,
 * before `send` returns; one that cannot be written is a defect, and the state stays as the file has it.
 *
 * It is for one process: nothing locks the file, so two processes that open it overwrite each other's events.
 * What a transition outputs is carried out by the caller after `send` has saved the state, so a crash between the
 * two leaves a payment recorded as charged but never submitted: each effect is delivered at most once.
 */
export function durable(file: string) {
  return Layer.effect(Machine, effect {
    const fs = try FileSystem.FileSystem
    effect function save(state: T.Assistant) {
      try scoped(effect {
        const temp = try fs.open(`${file}.tmp`, { flag: "w" })
        try temp.writeAll(new TextEncoder().encode(JSON.stringify(state)))
        try temp.sync
      })
      try fs.rename(`${file}.tmp`, file)
    }
    const text = (try fs.exists(file)) ? try fs.readFileString(file) : undefined
    const saved = text === undefined
      ? initial
      : try decodeState(try Effect.try({ try: () => JSON.parse(text), catch: () => new NotAState({ input: text }) }))
    const restarted = (try apply(saved, { type: "restart" }, "World")).state
    try save(restarted)
    const held = try SubscriptionRef.make(restarted)
    effect function send(event: T.Event, by: T.Actor): T.Chosen!Rejected {
      return try SubscriptionRef.modifyEffect(held, effect (current) => {
        const next = try apply(current, event, by)
        try orDie(save(next.state))
        return [next, next.state] as const
      })
    }
    return {
      changes: SubscriptionRef.changes(held),
      get: () => SubscriptionRef.get(held),
      send,
      effect receive(input: unknown, by: T.Actor) { return try send(try decodeEvent(input), by) }
    }
  })
}
