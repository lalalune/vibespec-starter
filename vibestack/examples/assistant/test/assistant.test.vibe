// The program's side of the trust boundary: who sent an event comes from the
// session it arrived on, never from the event (spec/assistant.md, "Who sends an event").
import { assert, it } from "@effect/vitest"
import { decodeEvent, Machine, machine } from "../gen/assistant.effect.vibe"
import type * as T from "../gen/assistant.effect.vibe"
import { hear } from "../src/agent.vibe"
import { type Scene, scriptedModel, scriptedWorld } from "../src/scripted.vibe"

/** The tag of the failure `by` gets for `event`; the state is as it was. */
effect function refusal(event: T.Event, by: T.Actor) {
  return (try flip((try Machine).send(event, by)))._tag
}

it.effect("an event cannot say who sent it", () => effect {
  const event = try decodeEvent({ type: "confirm", by: "Person" })
  try Effect.try(() => assert.deepStrictEqual(event, { type: "confirm" }))
})

it.effect("only the person starts a turn and confirms a payment", () => effect {
  provide machine() {
    const assistant = try Machine
    const agentBegins = try refusal({ type: "begin" }, "Agent")
    try assistant.send({ type: "begin" }, "Person")
    try assistant.send({ type: "choose", choice: "Lookup" }, "Agent")
    try assistant.send({ type: "reply", request: 1, amount: 5 }, "World")
    try assistant.send({ type: "choose", choice: "Review" }, "Agent")
    try assistant.send({ type: "load", page: "Genuine" }, "World")
    const asking = try assistant.send({ type: "choose", choice: "Pay" }, "Agent")
    const agentConfirms = try refusal({ type: "confirm" }, "Agent")
    const afterAgent = try assistant.get()
    const afterPerson = try assistant.send({ type: "confirm" }, "Person")
    try Effect.try(() => assert.deepStrictEqual(
      [agentBegins, asking.state.phase, agentConfirms, afterAgent.charged, afterPerson.state.charged],
      ["Rejected", "Asking", "Rejected", 0, 1]
    ))
  }
})

// spec/assistant.md, "Story: Take a turn"; spec/assistant.md, "Story: Look up the bill"; spec/assistant.md, "Story: Pay a bill"; spec/assistant.md, "Story: Keep my details safe"
it.effect("take a turn, look up the bill and pay it once, whatever the model says", () => effect {
  const scene: Scene = { page: "Lookalike", bills: [0, 5], done: [] }
  const answers = ["Lookup", "Fill", "Review", "Pay", "Speak", { type: "confirm" }, "Pay", "Fill", "Recite", "Speak"]
  provide machine(), scriptedWorld(scene), scriptedModel(answers) {
    // spec/assistant.md, "Only the person confirms a payment, and only while asked": nothing is asked yet.
    const early = try flip(hear("confirm"))
    // spec/assistant.md, "Only the world replies, and only to the request still waiting": the biller's 0 is refused, its 5 taken.
    // spec/assistant.md, "Card details go only into the biller's own page": the Fill on the lookalike types nothing.
    const asked = try hear("begin")
    // spec/assistant.md, "A bill is paid only on the biller's own page"
    const onLookalike = try flip(hear("confirm"))
    scene.page = "Genuine"
    const paid = try hear("confirm")
    // spec/assistant.md, "The model chooses each action, and each costs one from the turn": an answer that is no choice ends the turn.
    const nonsense = try hear("begin")
    // spec/assistant.md, "A bill is charged once, and only when the person confirms"; spec/assistant.md, "Nothing secret is said aloud": reciting the card is no choice at all.
    const again = try hear("begin")
    const silent = try hear("begin")
    try Effect.try(() => assert.deepStrictEqual(
      {
        early: early._tag,
        asked: [asked.state.phase, asked.state.bill, asked.refused],
        onLookalike: onLookalike._tag,
        paid: [paid.state.phase, paid.state.bill, paid.state.charged],
        nonsense: [nonsense.state.phase, nonsense.refused.map((r) => r._tag)],
        again: [again.state.phase, again.state.charged, again.refused.map((r) => r._tag)],
        silent: [silent.state.phase, silent.state.budget, silent.refused.map((r) => r._tag)],
        done: scene.done
      },
      {
        early: "Rejected",
        asked: ["Asking", { amount: 5, reviewed: true, paid: false }, []],
        onLookalike: "Rejected",
        paid: ["Done", { amount: 5, reviewed: true, paid: true }, 1],
        nonsense: ["Done", ["NotAnEvent"]],
        again: ["Done", 1, ["NotAnEvent"]],
        silent: ["Done", 2, ["NoAnswer"]],
        done: [{ tag: "Said", text: "paid" }, { tag: "Filled", page: "Genuine", card: "" }, { tag: "Said", text: "paid" }]
      }
    ))
  }
})
