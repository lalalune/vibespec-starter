// The real server on a free port, serving the page the `test` script built, with an HttpClient that reaches it, and tabs
// that talk to it as the page's do.
import { assert, it } from "@effect/vitest"
import { type Client, view } from "../gen/client.effect.vibe"
import { Machine } from "../gen/server.effect.vibe"
import { sameTodos } from "../gen/todo.effect.vibe"
import type { Answer } from "../src/protocol.vibe"
import { listening, server } from "../src/server.vibe"
import { type Tab, newId, open } from "../src/web/sync.vibe"

module node {
  import { type Server, createServer } from "node:http"
  let served: Server | undefined
  /** @throws {never} */
  export function create() {
    return (served = createServer())
  }
  /** Cut every connection to the server, as a network failure does. */
  export function dropConnections() {
    served?.closeAllConnections()
  }
}
import { create, dropConnections } from node

const Served = Layer.provideMerge(Layer.provide(HttpServer.layerTestClient, FetchHttpClient.layer), server("dist/web", listening(0, create)))

effect function send(body: string, type = "application/json") {
  return try HttpClient.execute(HttpClientRequest.bodyText(HttpClientRequest.post("/api/events"), body, type))
}

effect function post(body: unknown) {
  const response = try send(JSON.stringify(body))
  return { status: response.status, body: (try response.json) as unknown as Answer }
}

effect function until(tab: Tab.Shape, ok: (c: Client) => boolean) {
  try timeout(Stream.runHead(Stream.filter(tab.changes, ok)), "5 seconds")
}

// spec/server.md, "Story: Change the list over HTTP"
it.live("change the list over HTTP", () => effect {
  provide Served {
    const store = try Machine

    // spec/server.md, "A new request whose edit makes sense is applied, raising the version by one"; spec/server.md, "No request is answered twice"
    const milk = { type: "create", client: "ann", seq: 1, id: "ann-1", title: "milk" }
    const first = try post(milk)
    const again = try post(milk)

    // spec/server.md, "A new request can be refused, which is logged with its edit and changes nothing else"
    const tick = { type: "setDone", client: "ann", seq: 2, id: "nobody", done: true }
    const refused = try post(tick)
    const refusedAgain = try post(tick)
    const logged = (try store.get()).log.length

    // spec/server.md, "A to-do is never taken out of the list, and a removed one stays removed"; spec/server.md, "A to-do can be removed, leaving a tombstone"
    const removed = try post({ type: "remove", client: "ben", seq: 1, id: "ann-1" })
    const recreate = try post({ type: "create", client: "ben", seq: 2, id: "ann-1", title: "milk" })

    // spec/server.md, "No request is answered twice"
    const forged = { type: "create", client: "dan", seq: 1, id: "dan-x", title: "forged" }
    const squatted = try post(forged)
    const real = try post({ type: "create", client: "dan", seq: 1, id: "dan-1", title: "milk" })
    const retried = try post(forged)

    // spec/server.md, "A new request can be refused, which is logged with its edit and changes nothing else"
    const refuse = try post({ type: "refuse", client: "eve", seq: 1, op: { kind: "create", id: "eve-1", title: "milk", done: false } })
    const created = try post({ type: "create", client: "eve", seq: 1, id: "eve-1", title: "milk" })

    // Input that is no request changes nothing.
    const fraction = try post({ type: "create", client: "ann", seq: 1.5, id: "x", title: "y" })
    const unknown = try post({ type: "explode" })
    const notJson = try send("{not json")
    const { version } = try store.get()
    const notSentAsJson = try send(JSON.stringify({ type: "remove", client: "zed", seq: 1, id: "eve-1" }), "text/plain")
    const after = (try store.get()).version

    const s = (try (try HttpClient.get("/api/snapshot")).json) as { version: number; todos: unknown[] }

    // The page names the script Vite built for it; nothing outside the build is served.
    const index = try (try HttpClient.get("/")).text
    const response = try HttpClient.get(/<script type="module"[^>]* src="([^"]+)"/.exec(index)?.[1] ?? "/")
    const js = try response.text
    const outside = try HttpClient.get("/src/../package.json")

    try Effect.try(() => assert.deepStrictEqual({
      first: [first.status, first.body.ok, first.body.version],
      again: [again.body.ok, again.body.version, again.body.todos.length],
      refused: [refused.body.ok, refused.body.version, refusedAgain.body.ok, logged],
      removed: [removed.body.ok, recreate.body.ok, recreate.body.todos.map((t) => [t.id, t.deleted])],
      forged: [squatted.body.ok, real.body.ok, real.body.todos.some((t) => t.id === "dan-1"), retried.body.ok],
      refuse: [refuse.status, created.body.ok],
      malformed: [fraction.status, unknown.status, notJson.status, notSentAsJson.status, after === version],
      snapshot: [s.version === version, s.todos.length],
      page: [response.status, /javascript/.test(response.headers["content-type"] ?? ""), js.length > 0, outside.status],
    }, {
      first: [200, true, 1],
      again: [true, 1, 1],
      refused: [false, 1, false, 2],
      removed: [true, false, [["ann-1", true]]],
      forged: [true, false, false, true],
      refuse: [400, true],
      malformed: [400, 400, 400, 415, true],
      snapshot: [true, 3],
      page: [200, true, true, 404],
    }))
  }
})

// spec/system.md, "Story: Edit together, online or not"
it.live("two tabs, one of them offline for a while, end up with the server's list", () => effect {
  provide Served {
    const server = try Machine
    // The tabs stop listening before the server closes.
    try scoped(effect {
      const a = try open("", "a")
      const b = try open("", "b")
      try Effect.forkScoped(a.listen())
      try Effect.forkScoped(b.listen())

      // a adds milk; b hears about it through the push stream.
      const milk = newId("a", try a.get())
      try a.edit({ type: "create", id: milk, title: "milk" })
      try until(b, (c) => c.seen === 1)

      // a goes offline and keeps editing; b ticks milk off meanwhile.
      try a.dispatch({ type: "goOffline" })
      const eggs = newId("a", try a.get())
      try a.edit({ type: "create", id: eggs, title: "eggs" })
      try a.edit({ type: "rename", id: milk, title: "oat milk" })
      const queued = (try a.get()).pending
      try b.edit({ type: "setDone", id: milk, done: true })
      const ticked = (try server.get()).version

      // A request that arrives twice is applied once.
      try a.send(queued[0]!)
      try a.send({ seq: 2, op: { kind: "create", id: eggs, title: "eggs", done: false } })
      const sentTwice = (try server.get()).version

      // Back online: the queue is sent again and the tab catches up.
      try a.goOnline()
      const caughtUp = (try server.get()).version
      try until(b, (c) => c.seen === caughtUp)
      try b.refresh()

      // spec/client.md, "Story: Hear back from the server": b's stream drops, b reconnects
      try sync(dropConnections)
      try a.edit({ type: "setDone", id: eggs, done: true })
      const { version, todos } = try server.get()
      try until(b, (c) => c.seen === version)

      const [ours, theirs] = [try a.get(), try b.get()]
      try Effect.try(() => assert.deepStrictEqual({
        steps: [queued.length, ticked, sentTwice],
        pending: [ours.pending.length, theirs.pending.length],
        seen: [ours.seen, theirs.seen],
        agree: [sameTodos(view(ours), view(theirs)), sameTodos(view(ours), todos)],
        list: view(ours).map((t) => [t.title, t.done]),
      }, {
        steps: [2, 2, 3],
        pending: [0, 0],
        seen: [version, version],
        agree: [true, true],
        list: [["oat milk", true], ["eggs", true]],
      }))
    })
  }
})

// spec/system.md, "Story: Editing alone is never refused"
it.live("a lone user's queued edits reach the server in order, and none is refused", () => effect {
  provide Served {
    const a = try open("", "a")
    try a.dispatch({ type: "goOffline" })
    const milk = newId("a", try a.get())
    try a.edit({ type: "create", id: milk, title: "milk" })
    try a.edit({ type: "setDone", id: milk, done: true })
    try a.edit({ type: "rename", id: milk, title: "oat milk" })
    try a.goOnline()
    const c = try a.get()
    try Effect.try(() => assert.deepStrictEqual(
      { pending: c.pending.length, refusals: c.refusals, list: view(c).map((t) => [t.title, t.done]) },
      { pending: 0, refusals: 0, list: [["oat milk", true]] },
    ))
  }
})
