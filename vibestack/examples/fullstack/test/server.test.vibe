// spec/server.md, "Story: Change the list over HTTP"
import { assert, layer } from "@effect/vitest"
import { Machine } from "../gen/server.effect.vibe"
import type { Answer } from "../src/protocol.vibe"
import { Served } from "./served.vibe"

effect function send(body: string, type = "application/json") {
  return try HttpClient.execute(HttpClientRequest.bodyText(HttpClientRequest.post("/api/events"), body, type))
}

effect function post(body: unknown) {
  const response = try send(JSON.stringify(body))
  return { status: response.status, body: (try response.json) as unknown as Answer }
}

layer(Served, { excludeTestServices: true })((it) => {
  it.effect("Story: Change the list over HTTP", () => effect {
    const store = try Machine

    // spec/server.md, "A new request whose edit makes sense is applied, raising the version by one"; spec/server.md, "A request is answered only once"
    const create = { type: "create", client: "ann", seq: 1, id: "ann-1", title: "milk" }
    const first = try post(create)
    const again = try post(create)

    // spec/server.md, "A new request can be refused, which is logged with its edit and changes nothing else"
    const tick = { type: "setDone", client: "ann", seq: 2, id: "nobody", done: true }
    const refused = try post(tick)
    const refusedAgain = try post(tick)
    const logged = (try store.get()).log.length

    // spec/server.md, "A to-do is never taken out of the list; removing it leaves a tombstone"
    const removed = try post({ type: "remove", client: "ben", seq: 1, id: "ann-1" })
    const recreate = try post({ type: "create", client: "ben", seq: 2, id: "ann-1", title: "milk" })

    // spec/server.md, "A request is answered only once"
    const forged = { type: "create", client: "dan", seq: 1, id: "dan-x", title: "forged" }
    const squatted = try post(forged)
    const real = try post({ type: "create", client: "dan", seq: 1, id: "dan-1", title: "milk" })
    const retried = try post(forged)

    // spec/server.md, "A new request can be refused, which is logged with its edit and changes nothing else"
    const refuse = try post({ type: "refuse", client: "eve", seq: 1, op: { kind: "create", id: "eve-1", title: "milk", done: false } })
    const created = try post({ type: "create", client: "eve", seq: 1, id: "eve-1", title: "milk" })

    const fraction = try post({ type: "create", client: "ann", seq: 1.5, id: "x", title: "y" })
    const unknown = try post({ type: "explode" })
    const notJson = try send("{not json")
    const { version } = try store.get()
    const notSentAsJson = try send(JSON.stringify({ type: "remove", client: "zed", seq: 1, id: "eve-1" }), "text/plain")
    const after = (try store.get()).version

    const s = (try (try HttpClient.get("/api/snapshot")).json) as { version: number; todos: unknown[] }

    // The page names the script Vite built for it.
    const index = try (try HttpClient.get("/")).text
    const response = try HttpClient.get(/<script type="module"[^>]* src="([^"]+)"/.exec(index)?.[1] ?? "/")
    const js = try response.text
    const outside = try HttpClient.get("/src/../package.json")

    try Effect.try(() => {
      assert.strictEqual(first.status, 200)
      assert.strictEqual(first.body.ok, true)
      assert.strictEqual(first.body.version, 1)
      assert.strictEqual(again.body.ok, true)
      assert.strictEqual(again.body.version, 1)
      assert.strictEqual(again.body.todos.length, 1)

      assert.strictEqual(refused.body.ok, false)
      assert.strictEqual(refused.body.version, 1)
      assert.strictEqual(refusedAgain.body.ok, false)
      assert.strictEqual(logged, 2)

      assert.strictEqual(removed.body.ok, true)
      assert.strictEqual(recreate.body.ok, false)
      assert.deepStrictEqual(recreate.body.todos.map((t) => [t.id, t.deleted]), [["ann-1", true]])

      assert.strictEqual(squatted.body.ok, true)
      assert.strictEqual(real.body.ok, false)
      assert.isFalse(real.body.todos.some((t) => t.id === "dan-1"))
      assert.strictEqual(retried.body.ok, true)

      assert.strictEqual(refuse.status, 400)
      assert.strictEqual(created.body.ok, true)

      assert.strictEqual(fraction.status, 400)
      assert.strictEqual(unknown.status, 400)
      assert.strictEqual(notJson.status, 400)
      assert.strictEqual(notSentAsJson.status, 415)
      assert.strictEqual(after, version)

      assert.strictEqual(s.version, version)
      assert.strictEqual(s.todos.length, 3)

      assert.strictEqual(response.status, 200)
      assert.match(response.headers["content-type"] ?? "", /javascript/)
      assert.isNotEmpty(js)
      assert.strictEqual(outside.status, 404)
    })
  })
})
