{
  "name": "fullstack-todo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "check": "node ../../spec.ts check",
    "gen": "node ../../spec.ts gen",
    "accept": "node ../../spec.ts accept",
    "build": "vibelang && node bundle.ts",
    "test": "vitest run",
    "start": "pnpm -s build && node dist/src/main.js"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.1",
    "effect": "4.1.1",
    "vibelang-runtime": "0.0.12"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.1",
    "@types/node": "^26.0.0",
    "esbuild": "^0.27.0",
    "vibelang": "0.0.12",
    "vibelang-unplugin": "0.0.12",
    "vibelang-vite": "0.0.12",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "overrides": {
      "@effect/platform-node-shared": "4.1.1"
    }
  }
}
