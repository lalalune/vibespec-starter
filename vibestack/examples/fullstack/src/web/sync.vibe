// spec/system.md, "Only a tab's oldest queued edit can be on its way unanswered"; spec/client.md, "Story: Hear back from the server"
// Shared by app.ts and test/e2e.test.vibe.
import { type Client, type Event, type Pending, NotAnEvent, apply, decodeEvent, initial } from "../../gen/client.effect.vibe"
import { toRequest } from "../protocol.vibe"

/** How long a tab waits before it tries the network again. */
const RETRY = "2 seconds"

/** The server did not answer, or said something that is no answer. */
export error Unanswered { cause: unknown }

/** An edit the user makes. */
export type Edit = Extract<Event, { type: "create" | "setDone" | "rename" | "remove" }>

/** One browser tab: a client of spec/client.md, and the requests that keep it in step with the server. */
export service Tab {
  readonly changes: Stream.Stream<Client>
  get(): Client!!
  /** One event of the client machine; one the rules do not allow changes nothing. */
  dispatch(event: Event): void!!
  /** A user edit: queued at once, and sent after the edits queued before it, for as long as the tab is online. */
  edit(event: Edit): void!!
  /** Send one queued edit and take in the answer, as a retry does. */
  send(p: Pending): void!Unanswered
  /** Take in the list as the server has it now. */
  refresh(): void!Unanswered
  /** Back online: catch up, then send the queue. */
  goOnline(): void!!
  /** Take in every push, reconnecting whenever the stream ends; it never returns. */
  listen(): void!!
}

/** A fresh id for a to-do this tab creates: unique, because the tab's name is. */
export function newId(name: string, c: Client): string {
  return `${name}-${c.made + 1}`
}

/** The part of an answer that says which event it is to its tab; the client machine decodes the rest. */
schema Verdict { readonly ok: boolean }

/** What the server said, as the event of the client machine it is to a tab. */
effect function heard(type: "receiveAck" | "receiveRefusal" | "receiveSnapshot", said: unknown) {
  if (typeof said !== "object" || said === null) throw new NotAnEvent({ input: said })
  return try decodeEvent({ ...said, type })
}

/** A new tab called `name`, talking to the server at `base`. */
export effect function open(base: string, name: string) {
  const client = HttpClient.mapRequest(HttpClient.filterStatusOk(try HttpClient.HttpClient), HttpClientRequest.prependUrl(base))
  const held = try SubscriptionRef.make(initial)
  const sending = try Semaphore.make(1)
  const get = () => SubscriptionRef.get(held)
  const asked = <A, E>(answer: A!E) => mapError(answer, (cause) => new Unanswered({ cause }))

  effect function dispatch(event: Event) {
    try SubscriptionRef.updateEffect(held, effect (c) => apply(c, event) catch () => c)
  }

  effect function send(p: Pending) {
    const request = toRequest(name, p.seq, p.op)
    if (request === undefined) throw new NotAnEvent({ input: p })
    const said = try (try client.execute(try HttpClientRequest.bodyJson(HttpClientRequest.post("/api/events"), request))).json
    const { ok } = try Schema.decodeUnknownEffect(Verdict)(said)
    const answer = try heard(ok ? "receiveAck" : "receiveRefusal", said)
    if (!("seq" in answer) || answer.seq !== p.seq) throw new NotAnEvent({ input: said })
    try dispatch(answer)
  }

  effect function refresh() {
    try dispatch(try heard("receiveSnapshot", try (try client.get("/api/snapshot")).json))
  }

  // Oldest first, one request at a time, for as long as the tab is online:
  // sending the whole queue at once would let the network reorder the user's own edits.
  const flush = Semaphore.withPermit(sending, effect {
    while (true) {
      const { online, pending: [oldest] } = try get()
      if (!online || oldest === undefined) return
      send(oldest) catch effect () => { try sleep(RETRY) }
    }
  })

  effect function pushes() {
    const response = try client.get("/api/stream")
    let buffered = ""
    for try (const read of Stream.decodeText(response.stream)) {
      const frames = (buffered + read).split("\n\n")
      buffered = frames.pop() ?? ""
      for (const frame of frames) {
        if (!frame.startsWith("data: ")) continue
        const push = heard("receiveSnapshot", try Effect.try(() => JSON.parse(frame.slice("data: ".length)))) catch () => undefined
        if (push) try dispatch(push)
      }
    }
  }

  return {
    changes: SubscriptionRef.changes(held),
    get,
    dispatch,
    effect edit(event: Edit) {
      try dispatch(event)
      try flush
    },
    send: (p: Pending) => asked(send(p)),
    refresh: () => asked(refresh()),
    effect goOnline() {
      try dispatch({ type: "goOnline" })
      refresh() catch () => undefined
      try flush
    },
    effect listen() {
      while (true) {
        // The stream ended or the server went away: server.vibe sends the current list first on the next connection.
        pushes() catch () => undefined
        try sleep(RETRY)
      }
    }
  }
}

/** The page's tab: `open`, over the browser's fetch. */
export function browser(base: string, name: string) {
  return Layer.provide(Layer.effect(Tab, open(base, name)), FetchHttpClient.layer)
}
