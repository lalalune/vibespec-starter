// spec/server.md, "The log tells which requests were answered, and with which edit each was accepted"; spec/server.md, "A new request can be refused, which is logged with its edit and changes nothing else"; spec/client.md, "Story: Hear back from the server"
import { type Rejected, type Server, Machine, NotAnEvent, acceptedAs, answered, decodeEvent, machine } from "../gen/server.effect.vibe"
import { type Answer, type Request, type Snapshot, opOf } from "./protocol.vibe"

module node {
  import { createServer } from "node:http"
  import { NodeHttpServer } from "@effect/platform-node"
  /** An HTTP server on `port` (0 picks a free one). A push stream never ends by itself, so closing does not wait for the open tabs. */
  export function listening(port: number, create = createServer) {
    return NodeHttpServer.layer(create, { port, gracefulShutdownTimeout: 0 })
  }
}
import { listening } from node

export { listening }

const noStore = { "cache-control": "no-store" }

function snapshot(s: Server): Snapshot {
  return { version: s.version, todos: s.todos }
}

/** The answer to one request: its edit is applied if the rules allow it, and refused if not. */
effect function answer(request: Request) {
  const machine = try Machine
  const { client, seq } = request
  const op = opOf(request)
  const as = (ok: boolean, s: Server): Answer => ({ ok, seq, ...snapshot(s) })
  // Answered before: nothing is applied again, and only a retry of the accepted edit is told it was accepted.
  const retried = ({ state }: Rejected) => as(acceptedAs(state, client, seq, op), state)
  return map(machine.send(request), (s) => as(true, s)) catch effect (rejected) =>
    answered(rejected.state, client, seq)
      ? retried(rejected)
      // `refuse` allows every number not answered yet, so one it rejects was answered meanwhile.
      : map(machine.send({ type: "refuse", client, seq, op }), (s) => as(false, s)) catch (again) => retried(again)
}

effect function postEvent() {
  return effect {
    const request = try HttpServerRequest.HttpServerRequest
    // src/web/sync.vibe sends JSON; a cross-site page cannot without a CORS preflight, which is never granted.
    if (!request.headers["content-type"]?.startsWith("application/json")) {
      return try HttpServerResponse.json({ error: "send application/json" }, { status: 415, headers: noStore })
    }
    // A body that is not JSON, or longer than the limit, is no event either.
    const event = try decodeEvent(request.json catch () => undefined)
    // `refuse` is the server's own decision.
    if (event.type === "refuse") throw new NotAnEvent({ input: event })
    return try HttpServerResponse.json(try answer(event), { headers: noStore })
  } catch effect (error) => match (error) {
    when NotAnEvent: try HttpServerResponse.json({ error: "not a well-formed request" }, { status: 400, headers: noStore });
    default: throw error;
  }
}

effect function getSnapshot() {
  return try HttpServerResponse.json(snapshot(try (try Machine).get()), { headers: noStore })
}

/** Server-sent pushes: the list as it is now, and again after every change to it. */
effect function getStream() {
  const pushes = Stream.changesWith(Stream.map((try Machine).changes, snapshot), (a, b) => a.version === b.version)
  return HttpServerResponse.stream(Stream.encodeText(Stream.map(pushes, (s) => `data: ${JSON.stringify(s)}\n\n`)), {
    contentType: "text/event-stream",
    headers: { ...noStore, connection: "keep-alive" }
  })
}

const Api = Layer.mergeAll(
  HttpRouter.add("POST", "/api/events", provideService(postEvent(), HttpServerRequest.MaxBodySize, ByteSize.kibibytes(64))),
  HttpRouter.add("GET", "/api/snapshot", getSnapshot()),
  HttpRouter.add("GET", "/api/stream", getStream())
)

/** The HTTP API and the page's files in `web`, on `listener`, over a server machine of its own. */
export function server(web: string, listener: ReturnType<typeof listening>) {
  const app = Layer.mergeAll(Api, HttpStaticServer.layer({ root: web }))
  return Layer.provideMerge(HttpRouter.serve(app, { disableLogger: true, disableListenLog: true }), Layer.mergeAll(machine(), listener))
}
