{
  "name": "vibespec",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node vibespec/spec.ts studio",
    "check": "node vibespec/spec.ts check",
    "gen": "node vibespec/spec.ts gen",
    "accept": "node vibespec/spec.ts accept",
    "new": "node vibespec/spec.ts new",
    "start": "vibelang --noEmit false && node build/src/main.js",
    "test": "vitest run",
    "demo": "pnpm --filter order-example demo",
    "selftest": "node --test vibespec/selftest.ts",
    "build": "node vibespec/spec.ts gen vibespec/studio && node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node -e \"fs.chmodSync('dist/spec.js', 0o755); fs.mkdirSync('dist/proof', { recursive: true }); fs.copyFileSync('vibespec/proof/lib.dfy', 'dist/proof/lib.dfy'); fs.cpSync('vibespec/studio/src/public', 'dist/studio/src/public', { recursive: true }); fs.cpSync('vibespec/std', 'dist/std', { recursive: true }); fs.copyFileSync('vibespec/conformance.ts', 'dist/conformance.ts')\"",
    "prepare": "pnpm build && node vibespec/spec.ts gen --if-valid"
  },
  "version": "0.1.0",
  "description": "Stories, rules and Quint in a Markdown spec tree; verified TypeScript out.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lalalune/vibespec-starter.git"
  },
  "homepage": "https://github.com/lalalune/vibespec-starter#readme",
  "bugs": "https://github.com/lalalune/vibespec-starter/issues",
  "keywords": [
    "formal-verification",
    "quint",
    "dafny",
    "typescript",
    "specification",
    "state-machine",
    "ai-agents"
  ],
  "bin": {
    "spec": "dist/spec.js"
  },
  "files": [
    "dist",
    ".claude/skills",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "dependencies": {
    "@informalsystems/quint": "^0.33.1",
    "lemmascript": "0.6.8",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@effect/platform-node": "4.1.1",
    "@effect/vitest": "4.1.1",
    "effect": "4.1.1",
    "vibelang": "0.0.12",
    "vibelang-runtime": "0.0.12",
    "vibelang-vite": "0.0.12",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "workspaces": [
    "vibespec/examples/*",
    "vibespec/studio"
  ],
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "overrides": {
      "@effect/platform-node-shared": "4.1.1"
    }
  }
}
