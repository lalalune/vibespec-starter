{
  "name": "onespec",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node tools/spec.ts check",
    "gen": "node tools/spec.ts gen",
    "sync": "node tools/spec.ts sync",
    "accept": "node tools/spec.ts accept",
    "demo": "npm run -s gen && node src/demo.ts",
    "selftest": "node --test tools/selftest.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build && node tools/spec.ts gen",
    "check:alpha": "cd examples/alpha-energy && node ../../tools/spec.ts check"
  },
  "version": "0.1.0",
  "description": "Stories, rules and a Quint model in one Markdown file; verified TypeScript out.",
  "bin": {
    "spec": "dist/spec.js"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "CONTRIBUTING.md"
  ],
  "dependencies": {
    "@informalsystems/quint": "^0.33.1",
    "lemmascript": "^0.6.8",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
