{
  "name": "vibestack",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node vibestack/spec.ts studio",
    "check": "node vibestack/spec.ts check",
    "gen": "node vibestack/spec.ts gen",
    "accept": "node vibestack/spec.ts accept",
    "new": "node vibestack/spec.ts new",
    "demo": "pnpm -C vibestack/examples/order demo",
    "selftest": "node --test vibestack/selftest.ts",
    "build": "turbo run build //#build:tool",
    "prepare": "pnpm build:tool && node vibestack/spec.ts gen --if-valid",
    "build:tool": "node vibestack/spec.ts gen vibestack/studio && node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node -e \"fs.chmodSync('dist/spec.js', 0o755); fs.mkdirSync('dist/proof', { recursive: true }); fs.copyFileSync('vibestack/proof/lib.dfy', 'dist/proof/lib.dfy'); fs.cpSync('vibestack/studio/src/public', 'dist/studio/src/public', { recursive: true }); fs.cpSync('vibestack/std', 'dist/std', { recursive: true }); fs.copyFileSync('vibestack/conformance.ts', 'dist/conformance.ts')\"",
    "test": "turbo run test //#test:tool",
    "test:affected": "turbo run test //#test:tool --affected",
    "test:browser": "turbo run test:browser",
    "test:models": "turbo run check //#check //#examples",
    "typecheck": "turbo run typecheck //#typecheck:tool",
    "lint": "turbo run //#lint:js",
    "lint:js": "eslint . --cache --cache-location node_modules/.cache/eslint/ --max-warnings 0",
    "lint:css": "stylelint \"**/*.css\" --cache --cache-location node_modules/.cache/stylelint/ --allow-empty-input",
    "analyze": "knip && madge --circular --extensions ts,tsx --ts-config tsconfig.json vibestack/spec.ts packages apps",
    "examples": "for d in vibestack/examples/*/; do pnpm -C \"$d\" install --frozen-lockfile --ignore-workspace && pnpm -C \"$d\" check || exit 1; done",
    "quick": "turbo run typecheck test //#typecheck:tool //#test:tool //#lint:js //#lint:css --affected",
    "verify": "turbo run build typecheck test test:browser check //#check //#typecheck:tool //#test:tool //#build:tool //#lint:js //#lint:css //#analyze //#examples",
    "typecheck:tool": "tsc --noEmit -p tsconfig.json",
    "test:tool": "vitest run"
  },
  "version": "0.1.0",
  "description": "Stories, rules and Quint in a Markdown spec tree; verified TypeScript out.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lalalune/vibestack.git"
  },
  "homepage": "https://github.com/lalalune/vibestack#readme",
  "bugs": "https://github.com/lalalune/vibestack/issues",
  "keywords": [
    "formal-verification",
    "quint",
    "dafny",
    "typescript",
    "specification",
    "state-machine",
    "ai-agents"
  ],
  "bin": {
    "spec": "dist/spec.js"
  },
  "files": [
    "dist",
    ".claude/skills",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "dependencies": {
    "@informalsystems/quint": "^0.33.1",
    "lemmascript": "^0.6.8",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.1",
    "@effect/vitest": "4.1.1",
    "@eslint-react/eslint-plugin": "catalog:",
    "@eslint/js": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "^26.6.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "effect": "4.1.1",
    "eslint": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "happy-dom": "catalog:",
    "jsdom": "catalog:",
    "knip": "catalog:",
    "madge": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard": "catalog:",
    "turbo": "catalog:",
    "typescript-eslint": "catalog:",
    "vibelang": "0.0.12",
    "vibelang-runtime": "0.0.12",
    "vibelang-vite": "0.0.12",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@10.24.0",
  "exports": {
    "./testing": "./vibestack/testing/index.ts",
    "./testing/vitest": "./vibestack/testing/vitest.ts",
    "./testing/generate": "./vibestack/testing/generate.ts",
    "./package.json": "./package.json"
  }
}
