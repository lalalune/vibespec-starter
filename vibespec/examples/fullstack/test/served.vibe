// The backend as the tests meet it: the real server on a free port with the
// frontend `bundle.ts` built, and an HttpClient that reaches it.
import { application } from "../src/server.vibe"

export service Connections {
  disconnect(): void!!
}

module node {
  import { createServer } from "node:http"
  import { NodeHttpServer } from "@effect/platform-node"
  /** @throws {never} */
  export function listening() {
    const server = createServer()
    return {
      layer: NodeHttpServer.layer(() => server, { port: 0, gracefulShutdownTimeout: 0 }),
      /** @throws {never} */
      disconnect() { server.closeAllConnections() }
    }
  }
}
import { listening } from node

export const Served = Layer.unwrap(effect {
  const listener = listening()
  const app = Layer.provideMerge(application("dist/web"), listener.layer)
  return Layer.provideMerge(
    Layer.provide(HttpServer.layerTestClient, FetchHttpClient.layer),
    Layer.merge(app, Layer.succeed(Connections, { disconnect: () => sync(listener.disconnect) }))
  )
})
