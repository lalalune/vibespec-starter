{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "src",
    "test",
    "gen/*.ts"
  ]
}
