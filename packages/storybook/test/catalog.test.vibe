import { it } from "@effect/vitest"

module node {
  import assert from "node:assert/strict"
  import fs from "node:fs"
  import os from "node:os"
  import path from "node:path"
  import { generateCatalog, scanCatalog } from "../src/catalog.ts"

  export function journey() {
    const root = fs.mkdtempSync(path.join(os.tmpdir(), "component-catalog-"))
    try {
      fs.mkdirSync(path.join(root, "src"))
      fs.symlinkSync(path.resolve("node_modules"), path.join(root, "node_modules"), "dir")
      fs.writeFileSync(path.join(root, "package.json"), JSON.stringify({ name: "@fixture/shop", type: "module" }))
      fs.writeFileSync(path.join(root, "src/Save.tsx"), `import type { ReactNode } from "react";
export function Save({ title, disabled = false }: { title: string; disabled?: boolean; tone?: "quiet" | "loud"; children?: ReactNode }) { return <button disabled={disabled}>{title}</button>; }
`)
      fs.writeFileSync(path.join(root, "src/Save.meta.tsx"), `export const meta = { args: { title: "Save" }, examples: { Waiting: { disabled: true } }, model: { spec: "spec/order.md", module: "order", state: "Order", events: ["save"] } };`)
      const scanned = scanCatalog(root)
      assert.equal(fs.existsSync(path.join(root, ".storybook")), false)
      const catalog = generateCatalog(root)
      assert.deepEqual(catalog, scanned)
      const save = catalog.components[0]!
      assert.equal(save.name, "Save")
      assert.equal(save.props.find((prop) => prop.name === "children")?.kind, "node")
      assert.equal(save.props.find((prop) => prop.name === "children")?.options, undefined)
      assert.deepEqual(save.props.find((prop) => prop.name === "tone")?.options, ["quiet", "loud"])
      assert.deepEqual(save.stories.find((story) => story.name === "Waiting")?.args, { title: "Save", disabled: true })
      assert.equal(save.model?.spec, "spec/order.md")
      const file = path.join(root, ".storybook/generated", `${save.id}.stories.tsx`)
      assert.match(fs.readFileSync(file, "utf8"), /export const Example1/)
      assert.equal(save.stories.at(-1)?.id, `${save.id}--example1`)
      const before = fs.statSync(file).mtimeMs
      assert.deepEqual(generateCatalog(root), catalog)
      assert.equal(fs.statSync(file).mtimeMs, before)
      fs.rmSync(path.join(root, "src/Save.tsx"))
      assert.deepEqual(generateCatalog(root).components, [])
      assert.equal(fs.existsSync(file), false)
    } finally { fs.rmSync(root, { recursive: true, force: true }) }
  }
}
import { journey } from node

it.effect("discover a component, inspect its variants, and remove stale generated stories", () => effect {
  try Effect.try(journey)
})
