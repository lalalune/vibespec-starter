{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "rootDirs": [
      ".",
      ".vibe/declarations"
    ]
  },
  "include": [
    "src",
    "test"
  ],
  "vibe": {
    "sidecarDir": ".vibe/declarations"
  }
}
