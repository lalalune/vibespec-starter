// spec/index.md, "Story: Keep a short list"
// The shell: the list of spec/index.md, kept in a KeyValueStore, which main.tsx makes the browser's localStorage.
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { type Event, type Rejected, type Tasks, apply, decodeState, initial } from "../gen/index.effect.vibe"
import { Saved } from "./tasks.schema.ts"

const KEY = "tasks"

/** The store could not be read, or did not take the list. */
export error NotSaved { cause: unknown }

effect function saved() { return KeyValueStore.toSchemaStore(try KeyValueStore.KeyValueStore, Saved) }

effect function read(store: KeyValueStore.SchemaStore<typeof Saved>) {
  const found = store.get(KEY) catch effect (error) => match (error) { when { _tag: "SchemaError" }: Option.none(); default: throw error; }
  return decodeState(Option.getOrUndefined(found)) catch () => initial
}

/** The stored list, or an empty one where the store holds nothing the rules call a list; fails where the store cannot be read. */
export effect function load() { return try read(try saved()) }

/** The list as this application last read or stored it, and the one way to change it. */
export service TaskList {
  /** The list now, then every later one. */
  readonly changes: Stream.Stream<Tasks>
  /**
   * Reads the stored list, which another tab may have changed, and stores the list `event` leads to from there: a
   * list that cannot be stored stays as it was.
   */
  send(event: Event): Tasks!(Rejected | NotSaved)
}

/** A `TaskList` that starts from the stored list, one `send` at a time. */
export const stored = Layer.effect(TaskList, effect {
  const store = try saved()
  const kept = <A, E>(storing: A!E) => mapError(storing, (cause) => new NotSaved({ cause }))
  const one = try Semaphore.make(1)
  const held = try SubscriptionRef.make(try read(store))
  return {
    changes: SubscriptionRef.changes(held),
    send: (event) => Semaphore.withPermit(one, effect {
      const current = try kept(read(store))
      try SubscriptionRef.set(held, current)
      const next = try apply(current, event)
      try kept(store.set(KEY, next))
      try SubscriptionRef.set(held, next)
      return next
    })
  }
})
