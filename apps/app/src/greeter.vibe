// spec/app/index.md, "Story: Say hello"
// The shell: the greeter of spec/app/index.md, kept in the KeyValueStore the program provides (main.tsx: localStorage).
// Each input's sender is where the page read it, never what the input says.
import { Machine, stored } from "../gen/app.effect.vibe"

/** The greeter, kept under "greeter". */
export const greeter = stored("greeter")

/** An event typed into the page; like any input, it is decoded before the rules see it. */
export effect function typed(input: unknown) {
  const machine = try Machine
  return try machine.receive(input, "Typed")
}

/** An event from the link the page was opened with (link.ts). */
export effect function linked(input: unknown) {
  const machine = try Machine
  return try machine.receive(input, "Linked")
}
