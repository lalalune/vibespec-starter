{
  "name": "@repo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "node ../../vibestack/spec.ts gen --if-valid",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vibelang --noEmit -p .",
    "check": "node ../../vibestack/spec.ts check",
    "gen": "node ../../vibestack/spec.ts gen",
    "accept": "node ../../vibestack/spec.ts accept",
    "test": "node ../../vibestack/testing/generate.ts . && vitest run",
    "test:browser": "vitest run -c vitest.browser.config.ts"
  },
  "dependencies": {
    "@repo/design-system": "workspace:*",
    "@repo/ui": "workspace:*",
    "effect": "4.1.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vibelang-runtime": "0.0.12"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.1",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "happy-dom": "catalog:",
    "playwright": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.12",
    "vibelang-vite": "0.0.12",
    "vibestack": "workspace:*",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
