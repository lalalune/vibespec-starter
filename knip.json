{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "vibestack/examples/**",
    "vibestack/fixtures/**",
    "**/gen/**",
    "**/dist/**",
    "**/generated/**",
    "**/test/fixtures/**",
    "vibestack/stories/test/project/**"
  ],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "vibestack/design/cli.ts",
        "vibestack/stories/cli.ts",
        "vibestack/*/test/*.test.ts"
      ],
      "project": [
        "vibestack/**/*.{ts,tsx}",
        "!vibestack/studio/**"
      ],
      "ignoreDependencies": [
        "@informalsystems/quint",
        "lemmascript",
        "@vitest/browser",
        "@effect/platform-node",
        "vibelang-runtime"
      ]
    },
    "packages/ui": {
      "entry": [
        "src/**/*.{meta,stories}.tsx",
        "test/**/*.test.{ts,tsx}"
      ],
      "project": [
        "**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "tailwindcss"
      ]
    },
    "packages/design-system": {
      "ignoreDependencies": [
        "eslint",
        "eslint-plugin-better-tailwindcss",
        "tailwindcss",
        "typescript-eslint"
      ]
    },
    "vibestack/studio": {
      "entry": [
        "src/project.ts",
        "src/doc.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "@effect/vitest",
        "playwright",
        "tailwindcss"
      ]
    }
  }
}
