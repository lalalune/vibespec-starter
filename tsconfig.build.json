{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "strict": true,
    "outDir": "dist",
    "rootDir": "vibespec",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ]
  },
  "include": [
    "vibespec/spec.ts",
    "vibespec/studio/src/server.ts",
    "vibespec/studio/src/page.ts"
  ]
}
