{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "strict": true,
    "outDir": "dist",
    "rootDir": "vibestack",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "rootDirs": [
      "vibestack",
      ".vibe/build"
    ]
  },
  "include": [
    "vibestack/spec.ts",
    "vibestack/studio/src/main.vibe",
    "vibestack/studio/src/page.ts",
    "vibestack/studio/gen/*.vibe"
  ],
  "vibe": {
    "sidecarDir": ".vibe/build"
  }
}
