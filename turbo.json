{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    ".nvmrc",
    "pnpm-workspace.yaml",
    "tsconfig.json"
  ],
  "globalEnv": [
    "CI",
    "FUZZ_RUNS",
    "FUZZ_SEED"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vibestack/*.ts",
        "$TURBO_ROOT$/vibestack/{gen,proof,std,testing,stories,design}/**",
        "!$TURBO_ROOT$/vibestack/**/node_modules/**"
      ],
      "outputs": [
        "dist/**",
        "generated/**",
        "storybook-static/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vibestack/*.ts",
        "$TURBO_ROOT$/vibestack/{gen,proof,std,testing,stories,design}/**",
        "!$TURBO_ROOT$/vibestack/**/node_modules/**"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vibestack/*.ts",
        "$TURBO_ROOT$/vibestack/{gen,proof,std,testing,stories,design}/**",
        "!$TURBO_ROOT$/vibestack/**/node_modules/**"
      ],
      "outputs": []
    },
    "test:browser": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vibestack/*.ts",
        "$TURBO_ROOT$/vibestack/{gen,proof,std,testing,stories,design}/**",
        "!$TURBO_ROOT$/vibestack/**/node_modules/**"
      ],
      "outputs": []
    },
    "check": {
      "dependsOn": [
        "build",
        "typecheck",
        "test",
        "test:browser"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vibestack/*.ts",
        "$TURBO_ROOT$/vibestack/{gen,proof,std,testing,stories,design}/**",
        "!$TURBO_ROOT$/vibestack/**/node_modules/**"
      ],
      "outputs": [
        "gen/**"
      ]
    },
    "//#check": {
      "dependsOn": [
        "//#build",
        "//#typecheck",
        "//#test"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/node_modules/**",
        "!**/gen/**",
        "!**/dist/**",
        "!**/.vibe/**",
        "!**/.cache/**",
        "!**/.spec-cache/**",
        "package.json",
        "tsconfig.json",
        "spec/**",
        "src/**",
        "test/**",
        "vitest.config.ts"
      ],
      "outputs": [
        "gen/**"
      ]
    },
    "//#lint:js": {
      "inputs": [
        "apps/**",
        "packages/**",
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/node_modules/**",
        "!**/gen/**",
        "!**/dist/**",
        "!**/.vibe/**",
        "!**/.cache/**",
        "!**/generated/**",
        "!**/storybook-static/**",
        "package.json",
        "pnpm-workspace.yaml",
        "eslint.config.js",
        "tsconfig.json"
      ],
      "outputs": [],
      "dependsOn": [
        "@repo/design-system#build",
        "@repo/web#typecheck"
      ]
    },
    "//#lint:css": {
      "inputs": [
        "apps/**",
        "packages/**",
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/node_modules/**",
        "!**/gen/**",
        "!**/dist/**",
        "!**/.vibe/**",
        "!**/.cache/**",
        "!**/generated/**",
        "!**/storybook-static/**",
        "package.json",
        "pnpm-workspace.yaml",
        "stylelint.config.js"
      ],
      "outputs": []
    },
    "//#analyze": {
      "inputs": [
        "apps/**",
        "packages/**",
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/node_modules/**",
        "!**/gen/**",
        "!**/dist/**",
        "!**/.vibe/**",
        "!**/.cache/**",
        "!**/generated/**",
        "!**/storybook-static/**",
        "package.json",
        "pnpm-workspace.yaml",
        "knip.config.js",
        ".madgerc",
        "tsconfig.json"
      ],
      "outputs": []
    },
    "//#examples": {
      "inputs": [
        "vibestack/**",
        "!**/node_modules/**",
        "!**/gen/**",
        "!**/.vibe/**",
        "!**/.spec-cache/**",
        "package.json"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#build": {
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/node_modules/**",
        "!**/gen/**",
        "!**/dist/**",
        "!**/.vibe/**",
        "!**/.cache/**",
        "!**/.spec-cache/**",
        "package.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "vibestack-studio#build",
        "vibestack-studio#typecheck",
        "vibestack-studio#test",
        "vibestack-studio#test:browser"
      ]
    },
    "//#typecheck": {
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/node_modules/**",
        "!**/gen/**",
        "!**/dist/**",
        "!**/.vibe/**",
        "!**/.cache/**",
        "!**/.spec-cache/**",
        "package.json",
        "tsconfig.json"
      ],
      "outputs": []
    },
    "//#test": {
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/node_modules/**",
        "!**/gen/**",
        "!**/dist/**",
        "!**/.vibe/**",
        "!**/.cache/**",
        "!**/.spec-cache/**",
        "package.json",
        "tsconfig.json",
        "test/**",
        "src/**",
        "vitest.config.ts"
      ],
      "outputs": []
    },
    "vibestack-studio#check": {
      "dependsOn": [
        "build",
        "typecheck",
        "test",
        "test:browser",
        "//#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vibestack/*.ts",
        "$TURBO_ROOT$/vibestack/{gen,proof,std,testing,stories,design}/**",
        "!$TURBO_ROOT$/vibestack/**/node_modules/**"
      ],
      "outputs": [
        "gen/**"
      ]
    }
  }
}
