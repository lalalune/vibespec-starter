{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "vibestack",
    "gen/*.ts"
  ],
  "exclude": [
    "vibestack/examples",
    "vibestack/studio",
    "node_modules",
    "vibestack/design/test",
    "vibestack/stories/test"
  ]
}
